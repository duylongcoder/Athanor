    {"key": "depth.1.intro", "text": "The air smells of cold stone and old candle."},
    {"key": "depth.2.intro", "text": "Water finds its way down. So do you."},
    {"key": "depth.3.intro", "text": "Something below keeps a slow, warm note."},
    {"key": "depth.4.intro", "text": "The roots here are thicker than the walls."},
    {"key": "depth.5.intro", "text": "No hum now. Only the place where seeds are planted."},
